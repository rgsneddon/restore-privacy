{
  "manifest_version": 3,
  "name": "Restore Privacy Suite",
  "short_name": "RP Suite",
  "version": "1.0.4",
  "description": "Rx Privacy Browser companion (MV3) for Restore Privacy Suite 1.0.4. Browser-scoped Connect/Disconnect only — not OS residual TUN. Use Suite native clients for system residual.",
  "action": {
    "default_title": "Restore Privacy Suite",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
