# Helsinki perc_chain internet node (Restore Privacy Suite v1.0.0)
#
# evolve-perc-internet (Render) is PAUSED to save money.
# Do not re-enable the paid Render service by default.
# Clients point at Helsinki (or PERC_RENDEZVOUS_URL override).

PORT=9478
PERC_RENDEZVOUS_PORT=9478
# Loopback only — nginx exposes https://135.181.152.10.sslip.io/perc
PERC_BIND_HOST=127.0.0.1
PERC_DATA_DIR=/opt/restore-privacy/perc_chain/data
PERC_PUBLIC_ENDPOINT=https://135.181.152.10.sslip.io/perc
PERC_SEED_USERNAME=evolve_seed_node
PERC_CHAIN_GENESIS_REVISION=2
NODE_ENV=production
# Solo Helsinki seed — set to a remote URL only for deliberate dual-seed.
# none|off|disabled|empty disables upstream (do not default to paid Render).
PERC_UPSTREAM_RENDEZVOUS_URL=none
